{
  "name": "temporal-hello-world",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:web": "next build",
    "start:web": "next start",
    "build": "tsc -p tsconfig.backend.json",
    "build.watch": "tsc -p tsconfig.backend.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "TS_NODE_PROJECT=tsconfig.backend.json ts-node src/worker.ts",
    "start.watch": "TS_NODE_PROJECT=tsconfig.backend.json nodemon src/worker.ts",
    "workflow": "TS_NODE_PROJECT=tsconfig.backend.json ts-node src/client.ts",
    "extract": "TS_NODE_PROJECT=tsconfig.backend.json ts-node src/extraction/index.ts",
    "test": "mocha --exit --require ts-node/register --require source-map-support/register src/mocha/*.test.ts"
  },
  "nodemonConfig": {
    "execMap": {
      "ts": "TS_NODE_PROJECT=tsconfig.backend.json ts-node"
    },
    "ext": "ts",
    "watch": [
      "src"
    ]
  },
  "dependencies": {
    "@ai-sdk/azure": "^3.0.27",
    "@ai-sdk/openai": "^3.0.26",
    "@libsql/client": "^0.17.0",
    "@mastra/core": "^1.2.0",
    "@mastra/libsql": "^1.2.0",
    "@mastra/memory": "^1.1.0",
    "@temporalio/activity": "^1.13.2",
    "@temporalio/client": "^1.13.2",
    "@temporalio/envconfig": "^1.13.2",
    "@temporalio/worker": "^1.13.2",
    "@temporalio/workflow": "^1.13.2",
    "ai": "^6.0.78",
    "axios": "^1.13.4",
    "chromadb": "^3.3.0",
    "dotenv": "^17.2.4",
    "form-data": "^4.0.5",
    "mongodb": "^7.1.0",
    "nanoid": "3.x",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.13.2",
    "@tsconfig/node22": "^22.0.0",
    "@types/mocha": "8.x",
    "@types/node": "^22.9.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "autoprefixer": "^10.4.24",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-deprecation": "^3.0.0",
    "mocha": "8.x",
    "nodemon": "^3.1.7",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
